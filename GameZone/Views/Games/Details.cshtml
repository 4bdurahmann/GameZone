@using GameZone.Settings
@model Game

@{
    ViewData["Title"] = Model.Name;
}

<div class="card border-primary rounded-4 mt-5 overflow-hidden">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8 px-4 pt-2 d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-info fs-6">@Model.Category?.Name</span>
                    <h1 class="fw-bolder">@Model.Name</h1>
                    <p class="fs-5">@Model.Description?</p>
                </div>
                <div>
                    @foreach (var gameDevice in Model.Devices) {
                        <i class="@gameDevice.Device.Icon me-2 fs-1"></i>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <img src="@($"{FileSettings.ImagePath}/{Model.Cover}")" alt="@Model.Name" class="w-100 rounded-3"/>
            </div>
        </div>
    </div>
</div>
